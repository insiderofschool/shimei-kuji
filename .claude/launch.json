{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shimei",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "var h=require('http'),f=require('fs'),p=require('path');h.createServer(function(q,r){var u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';f.readFile(p.join(process.cwd(),u),function(e,d){if(e){r.writeHead(404);r.end();return}r.writeHead(200,{'Content-Type':u.slice(-5)==='.html'?'text/html; charset=utf-8':'application/octet-stream','Cache-Control':'no-store'});r.end(d)})}).listen(8765)"],
      "port": 8765
    }
  ]
}
